# Copy to .env and edit. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=vllmbench
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vllmbench
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# GPU host agent
# ---------------------------------------------------------------------------
# The agent's address is not set here. It belongs to the host, so it is entered when
# registering that host in the UI (Hosts -> Register) or posted to /api/hosts, and stored
# with it. Nothing would read a value put here.
#
# Shared secret between the control plane and the agent. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
VLLMBENCH_TOKEN=change-me

# Agent-side only, and normally unset. Set it on the GPU host when the agent is NOT
# installed in the vLLM environment. Prefer this to putting the vLLM venv on PATH.
# VLLMBENCH_VLLM_BIN=/home/you/vllm-env/.venv/bin/vllm

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=8080

# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------
# /mcp is authenticated by bearer token only. Adequate on a trusted LAN and
# inadequate on the public internet; do not expose it beyond the local network.
# See docs/adr/0001-mcp-server-interface.md.
VLLMBENCH_MCP_ENABLED=false
VLLMBENCH_MCP_WRITE_ENABLED=true

# The token MCP clients present. Enabling MCP without setting this leaves the
# surface mounted but inert — every call is refused — rather than open.
VLLMBENCH_MCP_TOKEN=

# Host headers /mcp accepts, comma-free JSON list, e.g. ["10.0.0.5:8000"].
# Empty turns DNS-rebinding protection off, which is the default: the control
# plane is reached by LAN address and there is no value we could guess, so the
# alternative would be broken on arrival. Rebinding protection defends a browser
# tricked into calling a local service; the bearer token is what guards this one.
VLLMBENCH_MCP_ALLOWED_HOSTS=[]

# Mock agent failure injection — dev profile only
#
# Set either to a FailureKind value and the mock refuses that way, with the same status
# code, message and X-Vllmbench-Failure-Kind header the real agent sends:
#
#   engine_out_of_memory | engine_config_rejected | engine_not_ready
#   benchmark_timeout    | benchmark_failed
#
# This is how the failure paths get exercised without a GPU. An engine cannot run out of
# memory on a laptop, and that is the failure a tuning sweep hits most often.
VLLMBENCH_MOCK_START_FAILURE=
VLLMBENCH_MOCK_BENCH_FAILURE=

# Log format — `json` or `text`
#
# Unset means json when stderr is not a terminal and text when it is, which is the right
# answer in both places it matters: a container writes json for whatever collects it, and
# a developer's terminal stays readable. Set this only to override that.
VLLMBENCH_LOG_FORMAT=

# Telemetry retention
#
# Delete engine and GPU samples for runs that finished more than this many days ago.
# 0 keeps everything, and is the default.
#
# Off deliberately. Telemetry is what turns "which config won" into "why it won", and a
# benchmarking framework that silently discarded that after ninety days — because ninety
# sounded reasonable — would be making a decision that belongs to whoever owns the
# results. Measured growth is roughly 7 MB per run-hour on eight GPUs, so the first year
# of a busy host is tens of gigabytes. GET /api/storage reports the real figure for your
# database, and POST /api/storage/prune is a dry run unless confirmed.
#
# Never deletes a run, a summary, or a raw benchmark payload. See PROTECTED in
# vllmbench_db/retention.py.
VLLMBENCH_TELEMETRY_RETENTION_DAYS=0

# Free space the agent requires before starting an engine or a benchmark, in bytes.
# Default 1 GiB; 0 disables the check. A disk with no room turns a forty-minute benchmark
# into a write error at the end of it.
VLLMBENCH_MIN_FREE_DISK_BYTES=1073741824
